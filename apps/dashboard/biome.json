{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["../../biome.json"],
  "files": {
    "includes": ["!**/src/index.css", "!**/src/lib/utils.ts", "!**/src/components/ui"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  }
}
